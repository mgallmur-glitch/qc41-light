{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mgallmur-glitch/qc41-light/schemas/qc41-light-report.schema.json",
  "title": "QC 4.1 Light Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "language", "transcript_quality", "call_summary", "call_outcome", "stage_analysis", "strengths", "breakpoint", "objections", "mistakes", "corrections", "recovery_line", "replay_plan", "next_call_focus", "next_call_checklist", "confidence", "limitations"],
  "properties": {
    "version": {"const": "qc41-light-0.2"},
    "language": {"type": "string", "pattern": "^(en|es)(-[A-Za-z0-9]+)?$"},
    "transcript_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "speaker_labels", "timestamps", "notes"],
      "properties": {
        "completeness": {"enum": ["complete", "partial", "fragment"]},
        "speaker_labels": {"type": "boolean"},
        "timestamps": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 3}}
      }
    },
    "call_summary": {"type": "string", "minLength": 20},
    "call_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["won", "lost", "follow_up", "no_decision", "disqualified", "unknown"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "stage_analysis": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status", "evidence", "finding"],
        "properties": {
          "stage": {"enum": ["opening", "agenda", "discovery", "problem", "impact", "solution", "proof", "price", "objection", "decision", "next_step", "unknown"]},
          "status": {"enum": ["strong", "partial", "weak", "not_observed"]},
          "evidence": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/evidence"}},
          "finding": {"type": "string", "minLength": 10}
        }
      }
    },
    "strengths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding", "evidence", "why_keep"],
        "properties": {
          "finding": {"type": "string", "minLength": 10},
          "evidence": {"$ref": "#/$defs/evidence"},
          "why_keep": {"type": "string", "minLength": 10}
        }
      }
    },
    "breakpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "evidence", "why_it_mattered"],
      "properties": {
        "stage": {"enum": ["opening", "agenda", "discovery", "problem", "impact", "solution", "proof", "price", "objection", "decision", "next_step", "unknown"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "why_it_mattered": {"type": "string", "minLength": 10}
      }
    },
    "objections": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "evidence", "interpretation", "confidence"],
        "properties": {
          "label": {"enum": ["timing", "priority", "trust", "fit", "price", "authority", "risk", "implementation", "unknown"]},
          "evidence": {"$ref": "#/$defs/evidence"},
          "interpretation": {"type": "string", "minLength": 10},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "mistakes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "finding", "evidence", "consequence"],
        "properties": {
          "id": {"type": "string", "pattern": "^M[1-3]$"},
          "category": {"enum": ["weak_agenda", "premature_pitch", "shallow_discovery", "missed_follow_up", "unsupported_claim", "overtalking", "weak_transition", "objection_not_clarified", "pressure", "vague_next_step", "poor_fit_not_addressed", "other"]},
          "finding": {"type": "string", "minLength": 10},
          "evidence": {"$ref": "#/$defs/evidence"},
          "consequence": {"type": "string", "minLength": 10}
        }
      }
    },
    "corrections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mistake_id", "action", "why", "example_line"],
        "properties": {
          "mistake_id": {"enum": ["M1", "M2", "M3"]},
          "action": {"type": "string", "minLength": 10},
          "why": {"type": "string", "minLength": 10},
          "example_line": {"type": "string", "minLength": 5}
        }
      }
    },
    "recovery_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "why"],
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "why": {"type": "string", "minLength": 10}
      }
    },
    "replay_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening_question", "diagnostic_follow_up", "objection_clarifier", "next_step_line"],
      "properties": {
        "opening_question": {"type": "string", "minLength": 10},
        "diagnostic_follow_up": {"type": "string", "minLength": 10},
        "objection_clarifier": {"type": "string", "minLength": 10},
        "next_step_line": {"type": "string", "minLength": 10}
      }
    },
    "next_call_focus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 5}
    },
    "next_call_checklist": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 5}
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason", "missing_context"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string", "minLength": 10},
        "missing_context": {"type": "array", "items": {"type": "string", "minLength": 3}}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "speaker", "timestamp"],
      "properties": {
        "quote": {"type": "string", "minLength": 2},
        "speaker": {"type": ["string", "null"]},
        "timestamp": {"type": ["string", "null"]}
      }
    }
  }
}
